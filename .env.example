# ==========================================
# EduCertify Environment Configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to Git.
# ==========================================

# Flask
SECRET_KEY=change-this-secret-in-production
FLASK_ENV=development
FLASK_DEBUG=true

# SQL Server Connection
SQL_SERVER=localhost
SQL_DATABASE=EduCertify
SQL_USERNAME=your_username
SQL_PASSWORD=your_password
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_TRUST_SERVER_CERTIFICATE=yes

# Set to "sqlite" to run locally without SQL Server (development/demo only)
DB_ENGINE=sqlite

# Firebase (optional - leave disabled for local development)
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=

# File uploads
MAX_UPLOAD_SIZE_MB=10

# Certificate verification base URL (used inside QR codes)
BASE_URL=http://127.0.0.1:5000
